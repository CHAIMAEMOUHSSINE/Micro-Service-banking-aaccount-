type Query {
    accountsList: [BankAccount]
    accountById(id: String): BankAccount
}
type Mutation{
    addAccount(bankAccount :BankAccountDTO): BankAccount


}
type BankAccount {
    id: String
    createAt: Float
    updateAt: Float
    balance: Float
    currency: String
    type: String
}
input BankAccountDTO{
    balance: Float
    currency: String
    type: String
}